# Ora AI — Frontend Environment Variables
# Copy to `.env` for local development or configure in Vercel Project Settings

# URL of the deployed Express backend API (e.g., https://ora-ai-api.vercel.app or http://localhost:5000)
VITE_API_BASE_URL=http://localhost:5000

# Google Maps JavaScript API Key (for dental clinic locator)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Enable development tools / logs
DEV=true
