# Dental Clinical Intelligence AI Stack — environment configuration
# Copy to `.env` and fill in values. `.env` is gitignored.

# --- Database ---
# Local default (zero setup, no admin, no Docker):
DATABASE_URL=sqlite:///./dental_ai.db
# Production Postgres (with pgvector if available):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dental_ai

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings (local, no API key) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Vector backend: "numpy" (default, in-process cosine) or "pgvector" ---
VECTOR_BACKEND=numpy

# --- Web research (Tavily) ---
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# --- Optional observability (LangSmith) ---
LANGCHAIN_TRACING=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=dental-ai
